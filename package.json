{
  "name": "omp-storm",
  "version": "0.25.0",
  "private": true,
  "description": "OMP Storm: plan, delegate, and verify coding, research, and operational work in omp",
  "type": "module",
  "author": "dhkimxx",
  "repository": { "type": "git", "url": "git+https://github.com/dhkimxx/omp-storm.git" },
  "keywords": ["omp-plugin", "oh-my-pi", "omp", "multi-agent", "orchestration"],
  "files": ["src", "agents", "priors", "README.md"],
  "omp": { "extensions": ["./src/entry.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "verify": "npm run check && npm test",
    "e2e": "bun scripts/e2e/run.ts",
    "e2e:auto": "bun scripts/e2e/auto.ts",
    "e2e:tui": "bun scripts/e2e/tui.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "19.2.1",
    "@oh-my-pi/pi-catalog": "19.2.1",
    "@oh-my-pi/pi-coding-agent": "19.2.1",
    "@oh-my-pi/pi-tui": "19.2.1",
    "@oh-my-pi/pi-utils": "19.2.1",
    "@types/bun": "1.4.5",
    "@types/node": "^22.19.0",
    "bun": "1.4.4",
    "typescript": "^5.9.3"
  }
}
